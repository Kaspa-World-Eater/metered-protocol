  {
   "section": "2",
   "about": "Canonical JSON, and the digest taken over it. Sorted keys, no insignificant whitespace.",
   "cases": [
    {
     "name": "nested objects sort by key at every level",
     "given": {
      "b": 1,
      "a": {
       "d": 4,
       "c": 3
      }
     },
     "expect": {
      "canonical": "{\"a\":{\"c\":3,\"d\":4},\"b\":1}",
      "digest": "01e1eca594767ceefeb7f27b5099fac5c1f8bfd666c7d140e04d538e6e56c69d"
     }
    },
    {
     "name": "arrays keep their order, unlike objects",
     "given": {
      "a": [
       3,
       1,
       2
      ]
     },
     "expect": {
      "canonical": "{\"a\":[3,1,2]}",
      "digest": "c79a0df4f21717febed9c43fab7a37594b9c157a01ba185c7938660fbdcde3fb"
     }
    },
    {
     "name": "non-ASCII is NOT escaped",
     "given": {
      "s": "Cafe 🔒 計量"
     },
     "expect": {
      "canonical": "{\"s\":\"Cafe 🔒 計量\"}",
      "digest": "4709ddb8b4ba13e1a329025cb63e74442f948a0a8f9a1bcbeb44d6ae53235ed2"
     }
    },
    {
     "name": "a null is preserved where the spec names one",
     "given": {
      "prevState": null,
      "seq": 0
     },
     "expect": {
      "canonical": "{\"prevState\":null,\"seq\":0}",
      "digest": "cfeb1de1bcd161fa9b6ce19cbbf7ae952e2a5c4e7bab8ee6a57bbf921e0a16df"
     }
    },
    {
     "name": "negative and zero integers",
     "given": {
      "a": -1,
      "b": 0,
      "c": -9007199254740991
     },
     "expect": {
      "canonical": "{\"a\":-1,\"b\":0,\"c\":-9007199254740991}",
      "digest": "c5319a83b84661ae89c8e78128970093732220d1230c47a431aa7432f9119e26"
     }
    },
    {
     "name": "UTF-16 code-unit order, where it DIFFERS from code-point order",
     "given": {
      "�": 1,
      "𐀀": 2
     },
     "expect": {
      "canonical": "{\"𐀀\":2,\"�\":1}",
      "digest": "2c6f001457cf78eb1e71a5110211a79a3f8cdfaeef3231c5e135e5d0410cc117"
     }
    },
    {
     "name": "BMP keys, where the two orders agree",
     "given": {
      "aＺ": 1,
      "aａ": 2,
      "az": 3
     },
     "expect": {
      "canonical": "{\"az\":3,\"aＺ\":1,\"aａ\":2}",
      "digest": "eb9dd5a425de835f202c28fb2bea23c62a0c470f598566524216e7a1021aa2d6"
     }
    }
   ]
  },
