{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "tools/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "tools/check*.ts", "tools/complexity.ts", "tools/done.ts", "tools/vague.ts", "tools/typecheck.ts", "tools/secrets.ts", "tools/publish-protocol.ts"]
}
